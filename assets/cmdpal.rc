#include <windows.h>

#define IDI_CMDPAL_APP 101

IDI_CMDPAL_APP ICON "cmdpal.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "CmdPal Open Source"
            VALUE "FileDescription", "CmdPal - Lightweight Windows Command Palette"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "CmdPal"
            VALUE "OriginalFilename", "CmdPal.exe"
            VALUE "ProductName", "CmdPal"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
